# Copiar para .env (local) ou definir no Render > Environment
MONGO_URL=mongodb+srv://UTILIZADOR:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=myg_reviews

# Domínio(s) do frontend, separados por vírgula, sem barra no fim
CORS_ORIGINS=https://myg-reviews.vercel.app,http://localhost:3000

# Login do painel /admin (o utilizador é criado no primeiro arranque)
ADMIN_EMAIL=o-seu-email@exemplo.com
ADMIN_PASSWORD=escolha-uma-password-forte
JWT_SECRET=gere-uma-string-aleatoria-longa

# Fotos carregadas no painel (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myg-reviews

# Opcional: deploy hook do Vercel para regenerar as páginas quando publica/edita uma review
VERCEL_DEPLOY_HOOK_URL=
