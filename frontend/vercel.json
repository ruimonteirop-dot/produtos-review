{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/reviews/:slug", "destination": "/spa.html" }
  ],
  "headers": [
    { "source": "/products/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
